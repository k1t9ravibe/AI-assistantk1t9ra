# Скопируй этот файл в .env и заполни.

# Ключ Anthropic: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Пароль для входа на сайт. Без него сайт открыт всем, кто знает адрес.
APP_PASSWORD=

# Адрес и порт. 127.0.0.1 — сайт доступен только с этой машины (или через nginx).
# 0.0.0.0 — доступен из сети напрямую.
HOST=127.0.0.1
PORT=3000

# Папка с чатами, базой знаний и настройками.
DATA_DIR=data
